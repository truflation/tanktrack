# Copy to .env and fill in. Never commit .env.

# AISstream.io — free key, register at https://aisstream.io/authenticate
AISSTREAM_API_KEY=

# SQLite file location (default: ./tanktrack.db at the repo root)
# TANKTRACK_DB_PATH=/absolute/path/tanktrack.db

# Anchor detection thresholds
ANCHOR_SOG_KT=0.5
ANCHOR_MIN_MINUTES=15

# FastAPI host / port
API_HOST=127.0.0.1
API_PORT=8088

LOG_LEVEL=INFO
